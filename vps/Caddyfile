# Same routes as the Hugging Face Space version, but upstreams are compose
# service names instead of 127.0.0.1, and the site address comes from .env:
#   SITE_ADDRESS=:80            -> plain HTTP (quick start, no domain needed)
#   SITE_ADDRESS=ai.example.com -> automatic HTTPS (Let's Encrypt)
{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	# keep-alive / monitoring endpoint
	handle /healthz {
		respond "ok" 200
	}

	# nice redirect: /hermes -> /hermes/
	@hermesRoot path /hermes
	redir @hermesRoot /hermes/ 301

	# Hermes Agent web dashboard (basic auth from DASHBOARD_* in .env)
	handle /hermes/* {
		uri strip_prefix /hermes
		header_up X-Forwarded-Prefix /hermes
		reverse_proxy hermes:9119
	}

	# Hermes Agent as an OpenAI-compatible API  ->  /hermes-api/v1
	handle /hermes-api/* {
		uri strip_prefix /hermes-api
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Allow-Headers "Authorization, Content-Type"
		}
		@hapiOpts method OPTIONS
		respond @hapiOpts 204
		reverse_proxy hermes:8642
	}

	# 9Router OpenAI-compatible API  ->  /v1
	handle /v1/* {
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Allow-Headers "Authorization, Content-Type"
		}
		@v1Opts method OPTIONS
		respond @v1Opts 204
		reverse_proxy router:20128
	}

	# everything else -> 9Router web dashboard
	handle {
		reverse_proxy router:20128
	}
}

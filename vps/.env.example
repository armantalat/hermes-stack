# ============================================================
#  vps/.env — configuration for the VM deployment
#  Copy to .env, then run:  bash bootstrap.sh
#  Blank password fields are auto-generated on first bootstrap
#  and printed + saved to ~/.hermes-stack-credentials.txt
# ============================================================

# ── site / TLS ──────────────────────────────────────────────
# ":80"                 -> plain HTTP on port 80  (works immediately, no domain)
# "ai.example.com"      -> automatic HTTPS via Let's Encrypt (needs a DNS A
#                          record pointing at this VM's public IP first)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# PUBLIC_BASE_URL=https://ai.example.com   # only if you use a reverse proxy in front

# ── Hugging Face (backups only — private datasets are still free, no PRO) ──
# Create a WRITE token: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_USERNAME=
BACKUP_REPO=              # e.g. yourname/hermes-backup  (auto-created, private)
BACKUP_INTERVAL=3600
BACKUP_FIRST_DELAY=300
BACKUP_KEEP_HOURS=72

# ── Telegram gateway (optional but recommended) ──
# @BotFather -> /newbot ; your numeric id: @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=   # comma-separated ids. Leave empty and the bot stays silent.

# ── agent ───────────────────────────────────────────────────
HERMES_TIMEZONE=UTC
# Leave blank for now: after the router dashboard is up, copy an exact model id
# from its "Models" tab, put it here, then: bash bootstrap.sh --reconfigure
HERMES_MODEL=
HERMES_WEB_BACKEND=tavily

# ── credentials (blank = generated on first bootstrap) ──────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=       # /hermes/ web dashboard basic auth
HERMES_API_KEY=           # bearer key for /hermes-api/v1
NINEROUTER_API_KEY=       # ALSO create this same key inside the router dashboard
ROUTER_INITIAL_PASSWORD=  # first login of the router dashboard (any username)
OMNI_ROUTER_KEY=          # keyless-models router key (sk-omni-...)
OMNI_ADMIN_PASSWORD=      # keyless-models dashboard password
OMNI_ENABLED=true
OMNI_AUTO_CHAIN=          # optional: qwen/qwen3.8-max,gemini/gemini-3.6-flash,...

# ── derived automatically by bootstrap.sh (don't edit) ──────
# AUTH_COOKIE_SECURE   = true when SITE_ADDRESS is a domain (HTTPS), else false
